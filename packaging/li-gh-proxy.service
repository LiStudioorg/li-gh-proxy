[Unit]
Description=li-gh-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=CONFIG_PATH=/etc/li-gh-proxy/config.toml
ExecStart=/usr/bin/li-gh-proxy
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=li-gh-proxy

[Install]
WantedBy=multi-user.target
