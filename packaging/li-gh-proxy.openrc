#!/sbin/openrc-run

name="li-gh-proxy"
description="Docker and GitHub acceleration proxy server"
command="/usr/bin/li-gh-proxy"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/li-gh-proxy.log"
error_log="/var/log/li-gh-proxy.log"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0

export CONFIG_PATH="/etc/li-gh-proxy/config.toml"

depend() {
    need net
    after firewall
}
